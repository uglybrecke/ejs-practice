<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice</title>
</head>
<body>
    <h1>EJS Practice</h1>

    <h2>Hello, <%= person.name %></h2>
    <h2>Your Occupation is: <%= person.occupation %></h2>
    <% if (['plumber', 'organist', 'bagpiper'].includes(person.occupation.toLowerCase())) 
        { %>
        <p>You work with pipes!</p>
    <% } else { %>
        <p>That's an interesting job!</p>
    <% } %>
    <h2>Your Favorite Color is: <%= person.favoriteColor %></h2>  
    <% if (['blue', 'red', 'yellow'].includes(person.favoriteColor.toLowerCase())) 
        { %>
        <p>What's not to love in a primary color!</p>
    <% } else if (['green', 'orange', 'purple'].includes(person.favoriteColor.toLowerCase())) { %>
        <p>Combining two colors to get one better!</p>
    <% } else { %>
        <p>Way to get specific! You like what you like and that's great!</p>
    <% } %>    
</body>
</html>